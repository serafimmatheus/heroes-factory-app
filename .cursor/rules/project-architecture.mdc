### 4.2. Classe de Entidade de Domínio - POO (src/models/Patient.ts)

```typescript
export interface IPatientData {
  id: string;
  name: string;
  birthDate?: string | Date;
  status: "active" | "inactive";
  createdAt: string;
}

export class Patient {
  public readonly id: string;
  public readonly name: string;
  public readonly birthDate?: Date;
  public readonly status: "active" | "inactive";
  public readonly createdAt: Date;

  constructor(data: IPatientData) {
    this.id = data.id;
    this.name = data.name;
    this.birthDate = data.birthDate ? new Date(data.birthDate) : undefined;
    this.status = data.status;
    this.createdAt = new Date(data.createdAt);
  }

  public get isActive(): boolean {
    return this.status === "active";
  }

  public get formattedBirthDate(): string {
    if (!this.birthDate) return "Não informada";
    return new Intl.DateTimeFormat("pt-BR").format(this.birthDate);
  }
}
```

### 4.3. Classe de Serviço de API - POO (src/services/PatientService.ts)

```typescript
import { api } from "@/lib/axios";
import { Patient, IPatientData } from "@/models/Patient";

export interface CreatePatientDTO {
  name: string;
  birthDate?: string;
  status: "active" | "inactive";
}

export class PatientService {
  public static async getAll(): Promise<Patient[]> {
    const response = await api.get<IPatientData[]>("/patients");
    return response.data.map((item) => new Patient(item));
  }

  public static async getById(id: string): Promise<Patient> {
    const response = await api.get<IPatientData>(`/patients/${id}`);
    return new Patient(response.data);
  }

  public static async create(payload: CreatePatientDTO): Promise<Patient> {
    const response = await api.post<IPatientData>("/patients", payload);
    return new Patient(response.data);
  }
}
```

### 4.4. Next.js Server Action (src/actions/patient-actions.ts)

```typescript
"use server";

import { revalidatePath } from "next/cache";
import { CreatePatientDTO } from "@/services/PatientService";

export async function createPatientAction(data: CreatePatientDTO) {
  try {
    const response = await fetch(`${process.env.API_INTERNAL_URL}/patients`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data),
    });

    if (!response.ok) {
      throw new Error("Erro ao criar paciente.");
    }

    revalidatePath("/patients");
    return { success: true, data: await response.json() };
  } catch (error) {
    return {
      success: false,
      error: error instanceof Error ? error.message : "Erro desconhecido",
    };
  }
}
```

### 4.5. Custom Hook com TanStack Query (src/hooks/usePatients.ts)

```typescript
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { PatientService, CreatePatientDTO } from "@/services/PatientService";
import { createPatientAction } from "@/actions/patient-actions";

export const PATIENTS_QUERY_KEY = ["patients"];

export function usePatients() {
  const queryClient = useQueryClient();

  const patientsQuery = useQuery({
    queryKey: PATIENTS_QUERY_KEY,
    queryFn: () => PatientService.getAll(),
  });

  const createPatientMutation = useMutation({
    mutationFn: async (payload: CreatePatientDTO) => {
      // Executa a action do servidor
      const result = await createPatientAction(payload);
      if (!result.success) throw new Error(result.error);
      return result.data;
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: PATIENTS_QUERY_KEY });
    },
  });

  return {
    patients: patientsQuery.data ?? [],
    isLoading: patientsQuery.isLoading,
    isError: patientsQuery.isError,
    createPatient: createPatientMutation.mutateAsync,
    isCreating: createPatientMutation.isPending,
  };
}
```

### 4.6. Molecule: Campo de Formulário com Shadcn (src/components/molecules/FormFieldText.tsx)

```typescript
import React from "react";
import { Control, FieldPath, FieldValues } from "react-hook-form";
import {
  FormControl,
  FormField,
  FormItem,
  FormLabel,
  FormMessage,
} from "@/components/ui/form";
import { Input } from "@/components/ui/input";

interface FormFieldTextProps<T extends FieldValues> {
  control: Control<T>;
  name: FieldPath<T>;
  label: string;
  placeholder?: string;
  type?: string;
}

export function FormFieldText<T extends FieldValues>({
  control,
  name,
  label,
  placeholder,
  type = "text",
}: FormFieldTextProps<T>) {
  return (
    <FormField
      control={control}
      name={name}
      render={({ field }) => (
        <FormItem className="w-full">
          <FormLabel>{label}</FormLabel>
          <FormControl>
            <Input placeholder={placeholder} type={type} {...field} />
          </FormControl>
          <FormMessage />
        </FormItem>
      )}
    />
  );
}
```

### 4.7. Organism: Formulário Completo (src/components/organisms/PatientCreateForm.tsx)

```typescript
"use client";

import React from "react";
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { z } from "zod";
import { Form } from "@/components/ui/form";
import { Button } from "@/components/ui/button";
import { FormFieldText } from "@/components/molecules/FormFieldText";
import { usePatients } from "@/hooks/usePatients";

export const patientFormSchema = z.object({
  name: z.string().min(2, "O nome deve ter no mínimo 2 caracteres"),
  birthDate: z.string().optional(),
  status: z.enum(["active", "inactive"]).default("active"),
});

export type PatientFormData = z.infer<typeof patientFormSchema>;

export function PatientCreateForm() {
  const { createPatient, isCreating } = usePatients();

  const form = useForm<PatientFormData>({
    resolver: zodResolver(patientFormSchema),
    defaultValues: {
      name: "",
      birthDate: "",
      status: "active",
    },
  });

  async function onSubmit(data: PatientFormData) {
    try {
      await createPatient(data);
      form.reset();
    } catch (error) {
      console.error(error);
    }
  }

  return (
    <Form {...form}>
      <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-4">
        <FormFieldText control={form.control} label="Nome Completo" name="name" placeholder="Ex: João da Silva" />
        <FormFieldText control={form.control} label="Data de Nascimento" name="birthDate" type="date" />
        <Button className="w-full" disabled={isCreating} type="submit">
          {isCreating ? "Salvando..." : "Cadastrar Paciente"}
        </Button>
      </form>
    </Form>
  );
}
```

